{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend Server",
      "type": "shell",
      "command": "${workspaceFolder}/server_venv/Scripts/python.exe app.py",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Frontend Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Build Frontend",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Run Backend Tests (Pytest)",
      "type": "shell",
      "command": "${workspaceFolder}/server_venv/Scripts/python.exe -m pytest tests -v",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
