# QueueSmart AI - Production Backend Environment Configuration

# Core Flask & Security
SECRET_KEY=queuesmart-ai-super-secret-key-production-ready-2026-xyz
JWT_SECRET_KEY=queuesmart-ai-jwt-secret-key-3c6c8c56-8c4a-41d5-ae93-a6c5f6a75cf8
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Database Configuration
# Leave DATABASE_URL empty to use self-contained SQLite (queuesmart.db), or set PostgreSQL URI:
# DATABASE_URL=postgresql://queuesmart:secure_db_pass@localhost:5432/queuesmart_db
DATABASE_URL=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,*

# Multi-Hospital & Default Tenant
DEFAULT_HOSPITAL_CODE=ACH-01
DEFAULT_HOSPITAL_NAME="Apex Care General Hospital"

# Server Concurrency & WSGI
GUNICORN_WORKERS=2
LOG_LEVEL=info
